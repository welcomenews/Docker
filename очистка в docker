#  отчет об использовании дискового пространства. предварительный анализ
$ docker system df
более полный
$ docker system df -v

# команда, которая удаляет неиспользуемые объекты
$ docker system prune

# удаляет не только висящие объекты, но и все неиспользуемые образы.
# не стоит использовать флаг -a без предварительного анализа, так как это может удалить образы, необходимые для быстрого отката или масштабирования.
$ docker system prune -a

# можете удалить все установленные контейнеры одним махом
ВНИМАНИЕ! Это приведет к удалению всех остановленных контейнеров.
$ docker container prune

# Если мы хотим удалить не только остановленные, но и запущенные контейнеры
$ docker rm -f $(docker ps –aq)
или более новая
$ docker container rm -f $(docker container ls -aq)

# показать образы, на основе которых собраны другие образы, 
# на которые не ссылается ни один из запущенных контейнеров – они могут быть удалены
$ docker image ls -f dangling=true

# intermediate это образы, на основе которых собраны другие образы. они не могут быть удалены, если вы используете контейнеры на базе этих самых «других» образов
# dangling образы – это такие intermediate образы, на которые не ссылается ни один из запущенных контейнеров. могут быть удалены

# Удалить их можно следующим способом (dangling образы)
$ docker image rm $(docker image ls -f dangling=true -q)
или
$ docker image prune

# удалить вообще все образы (а не только dangling) одной командой
$ docker image rm $(docker image ls -q)

# удаления всех томов (volumes) в Docker. для освобождения дискового пространства, занятого томами, которые больше не используются.
$ docker volume rm $(docker volume ls -q)
или
# для удаления всех локальных томов, которые не используются хотя бы одним контейнером.
$ docker volume prune

# BuildKit. С помощью этой штуки увеличивается скорость процесса, оптимизируется управление хранением данных и безопасностью.
# соберем наше приложение, с использованием BuildKit.
$ DOCKER_BUILDKIT=1 docker build -t app:2.0 .

# Для очистки кэш сборки (buid-cache)
$ docker builder prune

